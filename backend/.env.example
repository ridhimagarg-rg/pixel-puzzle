# Copy this file to .env for local development.
# In production (Render), set these as real Environment Variables in the dashboard instead of committing a .env file.

# Neon Postgres connection string, e.g.
# postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/pixelpuzzle?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/pixelpuzzle

# Port the Express server listens on. Render sets this automatically via process.env.PORT,
# this value is only used when nothing is provided by the host.
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
# Add both your local dev URL and your deployed Vercel URL.
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app
